{
  "name": "@jerryan/pi-subagent-tools",
  "version": "0.2.0",
  "description": "Minimal pi extension: delegate, review, and explore via in-process subagent sessions",
  "type": "module",
  "main": "index.ts",
  "files": [
    "index.ts",
    "agents.ts",
    "render.ts",
    "git-tool.ts",
    "ui-bridge.ts",
    "tui.ts",
    "prompts/*.md",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "pi",
    "pi-extension",
    "pi-package",
    "subagent",
    "delegate",
    "review",
    "explore"
  ],
  "license": "MIT",
  "author": "Zerui An",
  "repository": {
    "type": "git",
    "url": "https://github.com/JerryAZR/pi-subagent-tools"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "test": "node --experimental-strip-types --import ./test/register-mocks.mjs --test test/*.test.ts"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.84.0",
    "@earendil-works/pi-coding-agent": ">=0.84.0",
    "@earendil-works/pi-tui": ">=0.84.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.4",
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@earendil-works/pi-tui": "^0.84.4",
    "@sinclair/typebox": "^0.34.0",
    "@types/node": "^20.0.0",
    "just-bash": "^3.4.2",
    "just-git": "^1.8.0",
    "typescript": "^5.4.0"
  }
}
